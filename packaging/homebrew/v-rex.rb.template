# Homebrew formula for V-Rex (doc 130, renamed in doc 159). Rendered per release by
# scripts/render_formula.py; the result goes into the tap JanderHungrige/homebrew-tap.
#
# A formula, not a cask, on purpose: casks mark what they download as quarantined, and
# an app without a paid Apple signature is then blocked. Formulae set no such mark.
class VRex < Formula
  desc "Vision Representation & Experimentation: train on vision foundation models"
  homepage "https://github.com/JanderHungrige/DinoTraining"
  url "https://github.com/JanderHungrige/DinoTraining/releases/download/v{{version}}/V-Rex_{{version}}_aarch64.app.tar.gz"
  sha256 "{{sha256}}"
  license "MIT"

  depends_on arch: :arm64
  depends_on :macos

  def install
    prefix.install "V-Rex.app"
    (bin/"v-rex").write <<~SH
      #!/bin/bash
      exec "#{opt_prefix}/V-Rex.app/Contents/MacOS/dinotraining" "$@"
    SH
  end

  def caveats
    <<~TEXT
      Start V-Rex with:
        v-rex
      On its first start it offers to add itself to ~/Applications, and it downloads
      Python and PyTorch once (about 1 GB).
    TEXT
  end

  test do
    assert_predicate prefix/"V-Rex.app/Contents/MacOS/dinotraining", :executable?
    assert_predicate prefix/"V-Rex.app/Contents/Resources/runtime/uv", :executable?
  end
end
