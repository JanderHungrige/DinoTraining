# Homebrew formula for DinoTraining (doc 130). Rendered per release by
# scripts/render_formula.py; the result goes into the tap JanderHungrige/homebrew-tap.
#
# A formula, not a cask, on purpose: casks mark what they download as quarantined, and
# an app without a paid Apple signature is then blocked. Formulae set no such mark.
class Dinotraining < Formula
  desc "Annotate, train, infer and generate data with DINOv2/v3 and Grounding DINO"
  homepage "https://github.com/JanderHungrige/DinoTraining"
  url "https://github.com/JanderHungrige/DinoTraining/releases/download/v{{version}}/DinoTraining_{{version}}_aarch64.app.tar.gz"
  sha256 "{{sha256}}"
  license "MIT"

  depends_on arch: :arm64
  depends_on :macos

  def install
    prefix.install "DinoTraining.app"
    (bin/"dinotraining").write <<~SH
      #!/bin/bash
      exec "#{opt_prefix}/DinoTraining.app/Contents/MacOS/dinotraining" "$@"
    SH
  end

  def caveats
    <<~TEXT
      Start DinoTraining with:
        dinotraining
      On its first start it offers to add itself to ~/Applications, and it downloads
      Python and PyTorch once (about 1 GB).
    TEXT
  end

  test do
    assert_predicate prefix/"DinoTraining.app/Contents/MacOS/dinotraining", :executable?
    assert_predicate prefix/"DinoTraining.app/Contents/Resources/runtime/uv", :executable?
  end
end
