# ==========================================================================
# DinoTraining — environment template. Copy to .env and fill in.
# NEVER commit .env. Only this .example file is tracked.
# ==========================================================================

# --- HuggingFace ---
# Required to download the GATED DINOv3 weights (facebook/dinov3-*).
# Create a token at https://huggingface.co/settings/tokens AFTER accepting the
# DINOv3 license on each model page. Leave blank to run DINOv2-only.
HF_TOKEN=

# Where downloaded model weights are cached (kept out of the installer).
# Defaults to a per-user app data dir if unset.
DINO_MODEL_CACHE_DIR=

# --- Backend (FastAPI sidecar) ---
DINO_API_HOST=127.0.0.1
DINO_API_PORT=8756
DINO_API_PREFIX=/api/v1

# Compute device: auto | cuda | mps | cpu
DINO_DEVICE=auto

# --- Datasets ---
# Root folder where annotated datasets are stored.
DINO_DATA_DIR=

# --- Logging ---
LOG_LEVEL=INFO

# --- Cloud (Wave 6 — leave blank until then) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GCP_PROJECT=
# AZURE_STORAGE_CONNECTION_STRING=
